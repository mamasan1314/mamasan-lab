# 複製成 .env 後填入實際值。.env 不會進 Git，這一份會。
# 值從 Meta App Dashboard → hopelight-publisher-IG → Instagram
# → API setup with Instagram login 取得。

# ---- App 層級（兩個帳號共用同一個 App） ----

# 等同 OAuth 的 client_id，會出現在授權網址中，不是機密。
INSTAGRAM_APP_ID=

# 機密。只放本機或後端 secret store，
# 不進 Git、不進終端輸出、不進文件、不貼聊天。
INSTAGRAM_APP_SECRET=

# ---- 帳號設定檔 ----
#
# 格式：INSTAGRAM_PROFILE_<名稱>_TOKEN / _USERNAME / _MODE
#
# 名稱只允許 A-Z 與 0-9，不可含底線。寫成 HOPELIGHT_MOMENT 會被安靜忽略、不報錯，
# 你會以為設好了其實沒有。第二帳號因此叫 MOMENT。
#
# MODE 只有兩種值：
#   production  真實客戶帳號。工具會顯示警告橫幅，寫入類操作需要額外確認。
#   sandbox     自己的測試帳號，可安全實驗。未指定時預設為 sandbox。
#
# USERNAME 是發布前的防呆比對：工具會確認權杖實際打到的帳號與登記的相同，
# 不同就中止。強烈建議填寫，這是防止「以為在測試、其實打到正式帳號」的最後一道防線。

# 正式：Tiffany 的品牌主帳號
INSTAGRAM_PROFILE_HOPELIGHT_TOKEN=
INSTAGRAM_PROFILE_HOPELIGHT_USERNAME=hopelight.ig
INSTAGRAM_PROFILE_HOPELIGHT_MODE=production

# 正式：Tiffany 的第二帳號
INSTAGRAM_PROFILE_MOMENT_TOKEN=
INSTAGRAM_PROFILE_MOMENT_USERNAME=hopelight.moment
INSTAGRAM_PROFILE_MOMENT_MODE=production

# 正式：Darren 自己的帳號
#
# 這個設定檔在 2026-09-03 之前叫 SANDBOX、MODE 是 sandbox。兩者都是錯的：
# `@darrenfiy` 是有 384 篇貼文的公開真帳號，而 sandbox 模式讓 adapter 的
# --confirm-production 防線對它永遠不觸發。那個命名讓兩段錯的引擎程式碼
# 看起來是對的（identity 樣式假設「名稱 == 模式」、引擎從不傳
# --confirm-production），當天造成三次故障。已更正為 DARRENFIY / production。
#
# 它現在是一個正常的 production 設定檔：可以用自己的帳號走完整 production
# 路徑找剩下的 bug，不必每次在客戶帳號上試。
INSTAGRAM_PROFILE_DARRENFIY_TOKEN=
INSTAGRAM_PROFILE_DARRENFIY_USERNAME=darrenfiy
INSTAGRAM_PROFILE_DARRENFIY_MODE=production

# 沒有加 --profile 時要用哪一個。
#
# 刻意留空。三個設定檔全部指向真實帳號，沒有一個適合當「猜錯時掉進去的地方」；
# 而過去那個「安全預設」其實是假的——它指向 @darrenfiy 這個公開真帳號。
#
# 留空時 loadApiConfig 會直接停下並列出可用名稱（lib/instagram-api.cjs），
# 不會替你猜要打哪個帳號。引擎那條路不受影響：它每次都明示 --profile，
# 取自頻道檔的 runtime.profileAlias。
#
# 要再設預設，先開一個真正空白的測試帳號，不要指向任何真人的動態。
INSTAGRAM_DEFAULT_PROFILE=

# ---- 相容舊格式（已淘汰，不要用）----
#
# 舊的 INSTAGRAM_LONG_LIVED_TOKEN / INSTAGRAM_TARGET_USERNAME 寫法仍可運作，
# 會被視為 hopelight 正式帳號。但它只能表達一個帳號，多帳號時鍵名會重複，
# 而解析器是後面蓋前面 —— 先寫的那支權杖會安靜消失，且 _USERNAME 防呆比對
# 擋不住（權杖與登記名稱仍然一致，只是標籤錯了）。
#
# 2026-09-03 起本專案已全面改用具名格式，.env 內不應再出現這兩個鍵。
